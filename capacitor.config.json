{
  "appId": "app.evim",
  "appName": "Evim",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "scheme": "Evim"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "launchShowDuration": 3000,
      "backgroundColor": "#F7F1E8",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    },
    "StatusBar": {
      "overlaysWebView": false
    }
  },
  "backgroundColor": "#F7F1E8"
}
