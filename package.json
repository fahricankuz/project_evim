{
  "name": "evim",
  "version": "0.4.0",
  "private": true,
  "description": "Kiracı ve mülk sahibi için kira yönetimi: web, iOS ve Android",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs 8000",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "build": "node scripts/build.mjs",
    "build:native": "node scripts/build.mjs --native && cap sync",
    "android": "npm run build:native && cap open android",
    "ios": "npm run build:native && cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@electric-sql/pglite": "^0.2.17",
    "@playwright/test": "1.49.1",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@revenuecat/purchases-capacitor": "^13.6.0",
    "@supabase/supabase-js": "^2.117.0"
  }
}
